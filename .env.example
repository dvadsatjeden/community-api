NODE_ENV=production
PORT=3021
PUBLIC_API_BASE_URL=https://api.dvadsatjeden.org
CORS_ORIGIN=https://app.dvadsatjeden.org,http://localhost:5173
# Trust only the private Docker reverse proxy network; do not use "true".
TRUST_PROXY=loopback,linklocal,uniquelocal
# Production requires a random value of at least 32 characters: openssl rand -hex 32
IMPORT_SECRET=
DATABASE_PATH=/app/data/sqlite/community.sqlite
# Legacy JSON files are imported once, transactionally, and left untouched.
LEGACY_DATA_DIR=/app/data
EVENTS_SOURCE_URL=https://prevadzky.dvadsatjeden.org/wp-json/dvadsatjeden-events/v1/list?country=sk,https://prevadzky.dvadsatjeden.org/wp-json/dvadsatjeden-events/v1/list?country=cz
IMPORT_INTERVAL_MINUTES=30
# Install integrations/wordpress/community-source.php on WP before using this endpoint.
# Any independent HTTPS API implementing docs/API_CONTRACTS.md can replace it.
COMMUNITIES_SOURCE_URL=https://www.dvadsatjeden.org/wp-json/community-map/v1/communities
COMMUNITIES_INTERVAL_MINUTES=15
IDEAS_ENABLED=true
# Optional. Keep this stable and backed up: changing it changes Nostr-derived accounts.
NOSTR_AUTH_SECRET=
# Optional; omit for one API instance. Shared Nostr challenges for multiple instances only.
REDIS_URL=
# Optional: generate a matching pair with web-push; leave both empty to disable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dvadsatjeden.org

EVENTS_TIME_ZONE=Europe/Bratislava
BACKUP_DIR=/app/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
