# Secrets — never commit
.env
.env.*
!.env.example

# Claude Code local settings
.claude/

# App compiled output
app/dist/

# Node
node_modules/
community-web/node_modules/
app/node_modules/

# Build outputs
community-web/dist/
community-web/dist-standalone/
standalone-dist/

# Historical WP assets are kept locally only.
archive/wordpress-plugin/**/assets/*
!archive/wordpress-plugin/**/assets/icon-192.png
!archive/wordpress-plugin/**/assets/icon-512.png

# ZIP releases
*.zip

# Runtime data (Docker volumes)
data/
app/data/

# Vite build stamp (postbuild reads it; not needed in git)
**/.dvc-build-meta.json

# Misc
.DS_Store
*.log
